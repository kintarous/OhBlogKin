---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { render } from "astro:content";

const aboutIndex = await getListPage("about", "-index");
const { Content } = await render(aboutIndex);
const { title, description, meta_title, image } = aboutIndex.data;

const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && aboutIndex.data.draft) {
  return Astro.redirect("/404");
}
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} kicker="// whoami" />
  <section class="section section--tight">
    <div class="wrap">
      <div class="prose" style="margin-inline:auto;">
        {
          image && (
            <figure class="page-figure">
              <ImageMod src={image} width={1200} height={700} alt={title} fit="cover" format="webp" />
            </figure>
          )
        }
        <Content />
      </div>
    </div>
  </section>
</Base>
