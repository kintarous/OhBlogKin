---
import Base from "@/layouts/Base.astro";
---

<Base title="Halaman tidak ditemukan">
  <section class="section">
    <div class="wrap" style="text-align:center;">
      <p class="err-code">404</p>
      <p class="kicker" style="margin-top:1rem;">// error: route not found</p>
      <h1 style="font-size:var(--fs-h2);margin-top:.8rem;">Halaman tidak ditemukan</h1>
      <p style="color:var(--ink-soft);margin:1rem auto 1.8rem;max-width:46ch;">
        Halaman yang kamu cari mungkin sudah dihapus, diganti namanya, atau
        memang belum pernah ada.
      </p>
      <a href="/" class="btn">Kembali ke beranda</a>
    </div>
  </section>
</Base>
