---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";

const contactIndex = await getListPage("contact", "-index");
const { contact_form_action }: { contact_form_action: string } = config.params;
const { title, description, meta_title, image } = contactIndex.data;

const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && contactIndex.data.draft) {
  return Astro.redirect("/404");
}
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} kicker="// ./contact.sh" description={description} />
  <section class="section section--tight">
    <div class="wrap" style="max-width:640px;">
      <div class="nl-terminal">
        <div class="term-bar">
          <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="term-title"><span class="fn">contact</span> — kirim pesan</span>
        </div>
        <form class="nl-body" action={contact_form_action} method="POST" style="display:grid;gap:.9rem;">
          <label class="prompt" for="name" style="margin:0;"><span class="cmd">$ nama</span></label>
          <input id="name" name="name" class="nl-input" placeholder="Nama lengkap" type="text" required />
          <label class="prompt" for="email" style="margin:0;"><span class="cmd">$ email</span></label>
          <input id="email" name="email" class="nl-input" placeholder="kamu@email.com" type="email" required />
          <label class="prompt" for="message" style="margin:0;"><span class="cmd">$ pesan</span></label>
          <textarea id="message" name="message" class="nl-input" placeholder="Tulis pesanmu..." required rows="7"></textarea>
          <div><button type="submit" class="btn">Kirim</button></div>
        </form>
      </div>
    </div>
  </section>
</Base>
