---
import BlogCard from "@/components/BlogCard.astro";
import Pagination from "@/components/Pagination.astro";
import settings from "@/config/settings.json";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import PageHeader from "@/partials/PageHeader.astro";

const BLOG_FOLDER = "blog";

const { slug } = Astro.params;
const postIndex = await getListPage(BLOG_FOLDER, "-index");

const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && postIndex.data.draft) {
  return Astro.redirect("/404");
}

const posts = await getSinglePage(BLOG_FOLDER);
const sortedPosts = sortByDate(posts);
const totalPages = Math.ceil(posts.length / settings.posts_per_page);
const currentPage = slug && !isNaN(Number(slug)) ? Number(slug) : 1;
const indexOfLastPost = currentPage * settings.posts_per_page;
const indexOfFirstPost = indexOfLastPost - settings.posts_per_page;
const currentPosts = sortedPosts.slice(indexOfFirstPost, indexOfLastPost);

export async function getStaticPaths() {
  const BLOG_FOLDER = "blog";
  const posts = await getSinglePage(BLOG_FOLDER);
  const totalPages = Math.ceil(posts.length / settings.posts_per_page);
  const paths = [];

  for (let i = 1; i < totalPages; i++) {
    paths.push({
      params: {
        slug: (i + 1).toString(),
      },
    });
  }
  return paths;
}
---

<Base
  title={postIndex.data.title}
  meta_title={postIndex.data.meta_title}
  image={postIndex.data.image}
  description={postIndex.data.description}
>
  <PageHeader
    title={postIndex.data.title}
    kicker="// semua tulisan"
    description={postIndex.data.description}
  />
  <section class="section">
    <div class="wrap">
      <div class="post-grid">
        {currentPosts.map((post) => <BlogCard data={post} />)}
      </div>
      <Pagination
        section={BLOG_FOLDER}
        currentPage={currentPage}
        totalPages={totalPages}
      />
    </div>
  </section>
</Base>
