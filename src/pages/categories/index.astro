---
import Base from "@/layouts/Base.astro";
import { getAllTaxonomy, getTaxonomy } from "@/lib/taxonomyParser.astro";
import chipColor from "@/lib/utils/chipColor";
import { humanize } from "@/lib/utils/textConverter";
import PageHeader from "@/partials/PageHeader.astro";

const BLOG_FOLDER = "blog";

const categories = await getTaxonomy(BLOG_FOLDER, "categories");
const allCategories = await getAllTaxonomy(BLOG_FOLDER, "categories");
---

<Base title={"Kategori"}>
  <PageHeader title={"Kategori"} kicker="// grep the archive" />
  <section class="section">
    <div class="wrap">
      <div class="topic-grid">
        {
          categories.map((category: string) => {
            const count = allCategories.filter((c) => c === category).length;
            return (
              <a class="topic" href={`/categories/${category}`}>
                <span class="tic" style={`--tc:${chipColor(category)}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 17l6-6-6-6M12 19h8" /></svg>
                </span>
                <span>
                  <span class="t-name">{humanize(category)}</span>
                  <span class="t-count">{count} tulisan</span>
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</Base>
