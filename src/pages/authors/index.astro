---
import Base from "@/layouts/Base.astro";
import { avatarUrl } from "@/lib/utils/cloudinaryTransform";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import PageHeader from "@/partials/PageHeader.astro";

const authorIndex = await getListPage("authors", "-index");

const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && authorIndex.data.draft) {
  return Astro.redirect("/404");
}

const authors = await getSinglePage("authors");
---

<Base title={authorIndex.data.title}>
  <PageHeader title={authorIndex.data.title} kicker="// git log --authors" />
  <section class="section">
    <div class="wrap">
      <div class="people-grid">
        {
          authors.map((author) => (
            <a class="person" href={`/authors/${author.id}`}>
              {author.data.image && <img src={avatarUrl(author.data.image)} alt="" />}
              <b>{author.data.title}</b>
              {author.data.description && <span class="role">{author.data.description}</span>}
              {author.body && <p class="bio" set:html={markdownify(author.body.slice(0, 120))} />}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
