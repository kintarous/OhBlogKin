<div class="relative w-full h-[65vh] min-h-[500px] bg-body dark:bg-darkmode-body border-b border-border dark:border-darkmode-border flex items-center justify-center overflow-hidden group">
  <!-- Elemen Canvas -->
  <canvas id="hero-game-canvas" class="absolute inset-0 w-full h-full z-0 pointer-events-auto cursor-crosshair"></canvas>
  
  <!-- Instruksi -->
  <div class="absolute bottom-6 z-10 text-xs font-medium text-text dark:text-darkmode-text-light pointer-events-none px-6 py-2 rounded-full border border-border dark:border-darkmode-border bg-light/80 dark:bg-darkmode-light/80 backdrop-blur transition-opacity duration-500 opacity-100 group-hover:opacity-20">
    ✈️ Geser mouse / sentuh untuk menggerakkan pesawat (Auto-shoot)
  </div>
</div>

<script>
  const canvas = document.getElementById('hero-game-canvas') as HTMLCanvasElement;
  
  if (canvas) {
    const ctx = canvas.getContext('2d');
    
    if (ctx) {
      const resize = () => {
        canvas.width = canvas.parentElement?.clientWidth || window.innerWidth;
        canvas.height = canvas.parentElement?.clientHeight || window.innerHeight;
      };
      window.addEventListener('resize', resize);
      resize();

      // Posisi Mouse/Touch
      let mouseX = canvas.width / 2;
      let targetX = canvas.width / 2;

      canvas.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        targetX = e.clientX - rect.left;
      });
      canvas.addEventListener('touchmove', (e) => {
        const rect = canvas.getBoundingClientRect();
        targetX = e.touches[0].clientX - rect.left;
      }, { passive: true });

      // Entitas Game
      const player = { x: canvas.width / 2, y: canvas.height - 80, size: 15, speed: 0.1 };
      let bullets: {x: number, y: number}[] = [];
      let enemies: {x: number, y: number, speed: number, size: number}[] = [];
      let stars: {x: number, y: number, speed: number, size: number}[] = [];
      let frame = 0;
      let score = 0;

      // Inisialisasi Bintang Background
      for (let i = 0; i < 50; i++) {
        stars.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          speed: Math.random() * 2 + 1,
          size: Math.random() * 2
        });
      }

      // Deteksi Warna Dinamis (Fix Dark Mode)
      const getThemeColor = () => {
        return getComputedStyle(document.body).color || 'rgba(150,150,150,1)';
      };

      const update = () => {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        
        const themeColor = getThemeColor();
        ctx.strokeStyle = themeColor;
        ctx.fillStyle = themeColor;

        // --- BINTANG (Background) ---
        ctx.globalAlpha = 0.2;
        stars.forEach(star => {
          star.y += star.speed;
          if (star.y > canvas.height) {
            star.y = 0;
            star.x = Math.random() * canvas.width;
          }
          ctx.beginPath();
          ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
          ctx.fill();
        });
        ctx.globalAlpha = 1.0;

        // --- PLAYER (Smooth follow mouse) ---
        player.x += (targetX - player.x) * player.speed;
        player.y = canvas.height - 80; // Selalu di bawah
        
        // Auto Shoot
        if (frame % 15 === 0) {
          bullets.push({ x: player.x, y: player.y - player.size });
        }

        // Gambar Player (Bentuk Pesawat/Panah atas)
        ctx.globalAlpha = 0.9;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(player.x, player.y - player.size); // Ujung depan
        ctx.lineTo(player.x + player.size, player.y + player.size); // Sayap kanan
        ctx.lineTo(player.x, player.y + player.size / 2); // Ekor
        ctx.lineTo(player.x - player.size, player.y + player.size); // Sayap kiri
        ctx.closePath();
        ctx.stroke();

        // --- BULLETS ---
        for (let i = bullets.length - 1; i >= 0; i--) {
          bullets[i].y -= 10; // kecepatan peluru
          
          ctx.beginPath();
          ctx.arc(bullets[i].x, bullets[i].y, 3, 0, Math.PI * 2);
          ctx.fill();

          if (bullets[i].y < 0) {
            bullets.splice(i, 1);
          }
        }

        // --- ENEMIES ---
        if (frame % 60 === 0) { // Spawn musuh setiap 60 frame
          enemies.push({
            x: Math.random() * (canvas.width - 40) + 20,
            y: -20,
            speed: Math.random() * 2 + 1.5,
            size: 15
          });
        }

        for (let i = enemies.length - 1; i >= 0; i--) {
          enemies[i].y += enemies[i].speed;

          // Gambar Musuh (Belah Ketupat)
          ctx.globalAlpha = 0.7;
          ctx.beginPath();
          ctx.moveTo(enemies[i].x, enemies[i].y - enemies[i].size);
          ctx.lineTo(enemies[i].x + enemies[i].size, enemies[i].y);
          ctx.lineTo(enemies[i].x, enemies[i].y + enemies[i].size);
          ctx.lineTo(enemies[i].x - enemies[i].size, enemies[i].y);
          ctx.closePath();
          ctx.stroke();

          // Hapus jika lewat layar
          if (enemies[i].y > canvas.height + 20) {
            enemies.splice(i, 1);
            continue;
          }

          // Deteksi Tabrakan (Peluru vs Musuh)
          let enemyDestroyed = false;
          for (let j = bullets.length - 1; j >= 0; j--) {
            const dist = Math.sqrt(Math.pow(bullets[j].x - enemies[i].x, 2) + Math.pow(bullets[j].y - enemies[i].y, 2));
            if (dist < enemies[i].size + 3) { // 3 = ukuran peluru
              bullets.splice(j, 1);
              enemyDestroyed = true;
              score += 10;
              break;
            }
          }

          if (enemyDestroyed) {
            enemies.splice(i, 1);
          }
        }

        // Tampilkan Skor secara minimalis di pojok kanan atas canvas
        ctx.globalAlpha = 0.5;
        ctx.font = "14px sans-serif";
        ctx.textAlign = "right";
        ctx.fillText("SCORE: " + score, canvas.width - 20, 30);
        ctx.globalAlpha = 1.0;

        frame++;
        requestAnimationFrame(update);
      };

      update();
    }
  }
</script>
