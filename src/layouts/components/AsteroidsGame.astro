---
---
<div class="relative w-full h-[65vh] min-h-[500px] bg-body dark:bg-darkmode-body border-b border-border dark:border-darkmode-border flex items-center justify-center overflow-hidden">
  <!-- Elemen Canvas -->
  <canvas id="hero-game-canvas" class="absolute inset-0 w-full h-full z-0 pointer-events-auto cursor-crosshair"></canvas>
  
  <!-- UI Utama (Mulai / Game Over) -->
  <div id="game-ui" class="relative z-10 flex flex-col items-center justify-center text-center bg-light/80 dark:bg-darkmode-light/90 backdrop-blur-md px-12 py-10 rounded-2xl shadow-lg border border-border dark:border-darkmode-border transition-all">
    <h1 id="game-title" class="text-4xl md:text-5xl font-extrabold text-dark dark:text-white mb-2">Skyforce Mini</h1>
    <p class="text-lg text-text dark:text-darkmode-text-light mb-8">
      Skor Tertinggi: <span id="highscore-display" class="font-bold text-primary dark:text-darkmode-primary">0</span>
    </p>
    <button id="start-btn" class="btn btn-primary px-8 py-3 text-lg pointer-events-auto hover:scale-105 transition-transform">
      Start Game
    </button>
  </div>

  <!-- Instruksi Mengambang -->
  <div id="instruction" class="absolute bottom-6 z-10 text-xs font-medium text-text dark:text-darkmode-text-light pointer-events-none px-6 py-2 rounded-full border border-border dark:border-darkmode-border bg-light/80 dark:bg-darkmode-light/80 backdrop-blur transition-opacity duration-1000 opacity-0 hidden">
    ✈️ Geser mouse / sentuh untuk terbang (Auto-shoot)
  </div>
</div>

<script>
  const canvas = document.getElementById('hero-game-canvas') as HTMLCanvasElement;
  
  if (canvas) {
    const ctx = canvas.getContext('2d');
    
    if (ctx) {
      // Element UI
      const uiContainer = document.getElementById('game-ui');
      const titleEl = document.getElementById('game-title');
      const highscoreEl = document.getElementById('highscore-display');
      const startBtn = document.getElementById('start-btn');
      const instructionEl = document.getElementById('instruction');

      // State Game
      let gameState = 'START'; // 'START', 'PLAYING', 'GAMEOVER'
      let score = 0;
      let highscore = parseInt(localStorage.getItem('skyforce_highscore') || '0');
      
      if (highscoreEl) highscoreEl.innerText = highscore.toString();

      // Responsif Canvas
      const resize = () => {
        canvas.width = canvas.parentElement?.clientWidth || window.innerWidth;
        canvas.height = canvas.parentElement?.clientHeight || window.innerHeight;
      };
      window.addEventListener('resize', resize);
      resize();

      // Input Mouse/Touch
      let targetX = canvas.width / 2;
      canvas.addEventListener('mousemove', (e) => {
        if (gameState !== 'PLAYING') return;
        const rect = canvas.getBoundingClientRect();
        targetX = e.clientX - rect.left;
      });
      canvas.addEventListener('touchmove', (e) => {
        if (gameState !== 'PLAYING') return;
        const rect = canvas.getBoundingClientRect();
        targetX = e.touches[0].clientX - rect.left;
      }, { passive: true });

      // Entitas Game
      const player = { x: canvas.width / 2, y: canvas.height - 80, size: 16, speed: 0.15 };
      let bullets: {x: number, y: number}[] = [];
      let enemies: {x: number, y: number, speed: number, size: number}[] = [];
      let stars: {x: number, y: number, speed: number, size: number}[] = [];
      let frame = 0;

      // Buat Bintang Background (Tetap jalan di menu)
      for (let i = 0; i < 60; i++) {
        stars.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          speed: Math.random() * 2 + 0.5,
          size: Math.random() * 1.5 + 0.5
        });
      }

      const getDist = (x1: number, y1: number, x2: number, y2: number) => {
        return Math.sqrt(Math.pow(x2 - x1, 2) + Math.pow(y2 - y1, 2));
      };

      const getThemeColor = () => {
        return getComputedStyle(document.body).color || 'rgba(150,150,150,1)';
      };

      const setGameOver = () => {
        gameState = 'GAMEOVER';
        if (score > highscore) {
          highscore = score;
          localStorage.setItem('skyforce_highscore', highscore.toString());
        }
        
        // Tampilkan Menu Kembali
        if (uiContainer && titleEl && highscoreEl && startBtn) {
          uiContainer.classList.remove('hidden');
          uiContainer.classList.add('flex');
          titleEl.innerText = "Game Over!";
          titleEl.classList.add('text-red-500');
          highscoreEl.innerText = highscore.toString();
          startBtn.innerText = "Play Again";
        }
      };

      // Tombol Start
      if (startBtn && uiContainer && instructionEl) {
        startBtn.addEventListener('click', () => {
          // Sembunyikan Menu
          uiContainer.classList.add('hidden');
          uiContainer.classList.remove('flex');
          
          // Munculkan Instruksi sebentar
          instructionEl.classList.remove('hidden');
          setTimeout(() => instructionEl.classList.add('opacity-100'), 50);
          setTimeout(() => instructionEl.classList.remove('opacity-100'), 3000);
          
          // Reset State
          gameState = 'PLAYING';
          score = 0;
          bullets = [];
          enemies = [];
          player.x = canvas.width / 2;
          targetX = canvas.width / 2;
          frame = 0;
        });
      }

      // Loop Utama
      const update = () => {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        
        const themeColor = getThemeColor();
        ctx.strokeStyle = themeColor;
        ctx.fillStyle = themeColor;

        // 1. Gambar Bintang (Selalu Bergerak)
        ctx.globalAlpha = 0.2;
        stars.forEach(star => {
          star.y += star.speed + (gameState === 'PLAYING' ? 1 : 0); // Lebih cepat saat main
          if (star.y > canvas.height) {
            star.y = 0;
            star.x = Math.random() * canvas.width;
          }
          ctx.beginPath();
          ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
          ctx.fill();
        });
        ctx.globalAlpha = 1.0;

        if (gameState === 'PLAYING') {
          // 2. Gerakkan Player
          player.x += (targetX - player.x) * player.speed;
          player.y = canvas.height - 80;
          
          // Batas Layar Player
          if (player.x < player.size) player.x = player.size;
          if (player.x > canvas.width - player.size) player.x = canvas.width - player.size;

          // Auto Shoot
          if (frame % 12 === 0) {
            bullets.push({ x: player.x, y: player.y - player.size });
          }

          // Gambar Player
          ctx.globalAlpha = 0.9;
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(player.x, player.y - player.size);
          ctx.lineTo(player.x + player.size, player.y + player.size);
          ctx.lineTo(player.x, player.y + player.size / 2);
          ctx.lineTo(player.x - player.size, player.y + player.size);
          ctx.closePath();
          ctx.stroke();

          // 3. Peluru
          for (let i = bullets.length - 1; i >= 0; i--) {
            bullets[i].y -= 12;
            ctx.beginPath();
            ctx.arc(bullets[i].x, bullets[i].y, 3, 0, Math.PI * 2);
            ctx.fill();
            if (bullets[i].y < 0) bullets.splice(i, 1);
          }

          // 4. Musuh
          // Spawn musuh berdasar waktu (makin lama makin cepat spawn)
          const spawnRate = Math.max(20, 60 - Math.floor(score / 50)); 
          if (frame % spawnRate === 0) {
            enemies.push({
              x: Math.random() * (canvas.width - 40) + 20,
              y: -20,
              speed: Math.random() * 2 + 2 + (score / 200), // Makin cepat sesuai skor
              size: 15
            });
          }

          for (let i = enemies.length - 1; i >= 0; i--) {
            enemies[i].y += enemies[i].speed;

            ctx.globalAlpha = 0.7;
            ctx.beginPath();
            ctx.moveTo(enemies[i].x, enemies[i].y - enemies[i].size);
            ctx.lineTo(enemies[i].x + enemies[i].size, enemies[i].y);
            ctx.lineTo(enemies[i].x, enemies[i].y + enemies[i].size);
            ctx.lineTo(enemies[i].x - enemies[i].size, enemies[i].y);
            ctx.closePath();
            ctx.stroke();

            // Lolos dari layar = Hilang
            if (enemies[i].y > canvas.height + 20) {
              enemies.splice(i, 1);
              continue;
            }

            // Tabrakan dengan Peluru
            let enemyDestroyed = false;
            for (let j = bullets.length - 1; j >= 0; j--) {
              if (getDist(enemies[i].x, enemies[i].y, bullets[j].x, bullets[j].y) < enemies[i].size + 3) {
                bullets.splice(j, 1);
                enemyDestroyed = true;
                score += 10;
                break;
              }
            }
            if (enemyDestroyed) {
              enemies.splice(i, 1);
              continue; // Lanjut ke musuh berikutnya
            }

            // Tabrakan dengan Player (GAME OVER)
            if (getDist(enemies[i].x, enemies[i].y, player.x, player.y) < enemies[i].size + player.size - 5) {
              setGameOver();
            }
          }

          // 5. HUD Skor
          ctx.globalAlpha = 0.8;
          ctx.font = "bold 20px sans-serif";
          ctx.textAlign = "right";
          ctx.fillText("Score: " + score, canvas.width - 20, 40);
          ctx.globalAlpha = 1.0;
        }

        frame++;
        requestAnimationFrame(update);
      };

      update();
    }
  }
</script>
