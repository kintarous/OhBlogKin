---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: "eager" | "lazy" | null | undefined;
  decoding?: "async" | "auto" | "sync" | null | undefined;
  format?: "auto" | "avif" | "jpeg" | "png" | "svg" | "webp";
  fit?: "cover" | "contain" | "fill" | "none" | "scale-down";
  class?: string;
  style?: any;
}

let {
  src,
  alt,
  width,
  height,
  loading,
  decoding,
  class: className,
  format,
  style,
  fit,
} = Astro.props;

const isExternal = src.startsWith("http");
let optimizedExternalSrc = src;

// MAGIC: Jika ini adalah link Cloudinary, otomatis kompres maksimal (q_auto, f_auto) & sesuaikan ukuran
if (isExternal && src.includes("cloudinary.com")) {
  const uploadIndex = src.indexOf('/upload/');
  if (uploadIndex !== -1) {
    const before = src.substring(0, uploadIndex + 8);
    const after = src.substring(uploadIndex + 8);
    // Menyuntikkan perintah kompresi ke URL Cloudinary
    optimizedExternalSrc = `${before}q_auto,f_auto,w_${width},c_limit/${after}`;
  }
}

// Logika untuk gambar lokal bawaan template
const images = import.meta.glob("/public/images/**/*.{jpeg,jpg,png,gif,svg}");
let isValidLocalPath = false;
let localImageSrc: any = null;

if (!isExternal) {
  const localPath = src.startsWith('/public') ? src : `/public${src}`;
  isValidLocalPath = images[localPath] ? true : false;
  
  if (isValidLocalPath) {
    localImageSrc = images[localPath]();
  } else {
    console.error(`\x1b[31mImage not found - ${src}.\x1b[0m Make sure the image is in the /public/images folder.`);
  }
}
---

{
  isExternal ? (
    <img
      src={optimizedExternalSrc}
      alt={alt}
      width={width}
      height={height}
      loading={loading || "lazy"}
      decoding={decoding || "async"}
      class={className}
      style={style}
    />
  ) : isValidLocalPath ? (
    <Image
      src={localImageSrc as Promise<{ default: ImageMetadata }>}
      alt={alt}
      width={width}
      height={height}
      loading={loading || "lazy"}
      fit={fit ? fit : "contain"}
      decoding={decoding || "async"}
      class={className}
      format={format || "webp"}
      style={style}
    />
  ) : null
}
