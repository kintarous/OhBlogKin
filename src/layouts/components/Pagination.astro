---
type Pagination = {
  section?: string;
  currentPage?: number;
  totalPages?: number;
};
const { section, currentPage = 1, totalPages = 1 }: Pagination = Astro.props;

const base = section ? `/${section}` : "";
const pageUrl = (page: number) => (page === 1 ? base || "/" : `${base}/page/${page}`);

let pageList: number[] = [];
for (let i = 1; i <= totalPages; i++) {
  pageList.push(i);
}
---

{
  totalPages > 1 && (
    <nav class="pager" aria-label="Halaman">
      {currentPage > 1 ? (
        <a href={pageUrl(currentPage - 1)} aria-label="Sebelumnya">←</a>
      ) : (
        <span class="off" aria-hidden="true">←</span>
      )}

      {pageList.map((page) =>
        page === currentPage ? (
          <span aria-current="page">{page}</span>
        ) : (
          <a href={pageUrl(page)}>{page}</a>
        ),
      )}

      {currentPage < totalPages ? (
        <a href={pageUrl(currentPage + 1)} aria-label="Berikutnya">→</a>
      ) : (
        <span class="off" aria-hidden="true">→</span>
      )}
    </nav>
  )
}
