---
import config from "@/config/config.json";
import settings from "@/config/settings.json";
import chipColor from "@/lib/utils/chipColor";
import { avatarUrl } from "@/lib/utils/cloudinaryTransform";
import readingTime from "@/lib/utils/readingTime";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import { getEntry } from "astro:content";
import ImageMod from "./ImageMod.astro";

const { blog_folder }: { blog_folder: string } = config.settings;
const summary_length = settings.excerpt_length;
const { data } = Astro.props;
const { title, image, author, categories, description } = data.data;

const authorEntry = await getEntry("authors", slugify(author));
const avatar = authorEntry?.data.image && avatarUrl(authorEntry.data.image);
const excerpt = description || plainify(data.body?.slice(0, Number(summary_length)) ?? "");
const href = `/${blog_folder}/${data.id}`;
---

<article class="pcard">
  <a class="pcard-media" href={href} tabindex="-1" aria-hidden="true">
    <ImageMod
      src={image || "/images/image-placeholder.png"}
      alt=""
      width={600}
      height={400}
      fit="cover"
      format="webp"
    />
  </a>
  <div class="pcard-body">
    <div class="pcard-chips">
      {
        categories.map((category: string) => (
          <a class="chip" href={`/categories/${slugify(category)}`} style={`--dot:${chipColor(category)}`}>
            <span class="dot" />
            {humanize(category)}
          </a>
        ))
      }
    </div>
    <h3><a href={href}>{title}</a></h3>
    <p class="excerpt">{excerpt}</p>
    <div class="pcard-foot">
      <a class="byline" href={`/authors/${slugify(author)}`}>
        {avatar && <img src={avatar} alt="" />}
        <b>{authorEntry?.data.title ?? humanize(author)}</b>
      </a>
      <span class="meta">{readingTime(data.body)}</span>
    </div>
  </div>
</article>
