---
import BlogCard from "@/components/BlogCard.astro";
import Disqus from "@/helpers/Disqus";
import { getSinglePage } from "@/lib/contentParser.astro";
import chipColor from "@/lib/utils/chipColor";
import { avatarUrl } from "@/lib/utils/cloudinaryTransform";
import dateFormat from "@/lib/utils/dateFormat";
import readingTime from "@/lib/utils/readingTime";
import similarItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { getEntry, render } from "astro:content";
import ImageMod from "./components/ImageMod.astro";

const COLLECTION_FOLDER = "blog";
const { post } = Astro.props;

const posts = await getSinglePage(COLLECTION_FOLDER);
const similarPosts = similarItems(post, posts).slice(0, 3);
const { Content, headings } = await render(post);
const { title, description, author, categories, image, date, tags } = post.data;

const authorEntry = await getEntry("authors", slugify(author));
const toc = headings.filter((heading) => heading.depth === 2);
const shareUrl = new URL(`/${COLLECTION_FOLDER}/${post.id}`, Astro.site).href;
const shareLinks = [
  { name: "WhatsApp", url: `https://wa.me/?text=${encodeURIComponent(`${title} ${shareUrl}`)}` },
  { name: "X", url: `https://x.com/intent/post?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(title)}` },
  { name: "Facebook", url: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}` },
  { name: "LinkedIn", url: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}` },
];
---

<article>
  <div class="article-hero">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">~/</a><span class="sl">/</span>
        <a href="/blog">blog</a><span class="sl">/</span>
        <span>{post.id}</span>
      </nav>
      <div class="pcard-chips" style="margin-top:1rem;">
        {
          categories.map((category: string) => (
            <a class="chip" href={`/categories/${slugify(category)}`} style={`--dot:${chipColor(category)}`}>
              <span class="dot" />
              {humanize(category)}
            </a>
          ))
        }
      </div>
      <h1 class="article-title" set:html={markdownify(title)} />
      {description && <p class="article-lead">{description}</p>}
      <div class="article-meta">
        <a class="byline" href={`/authors/${slugify(author)}`}>
          {authorEntry?.data.image && <img src={avatarUrl(authorEntry.data.image)} alt="" />}
          <span>
            <b>{authorEntry?.data.title ?? humanize(author)}</b>
            {authorEntry?.data.description && (
              <>
                <br />
                <span class="m">{authorEntry.data.description}</span>
              </>
            )}
          </span>
        </a>
        <span class="meta">
          {date && dateFormat(date)}
          {date && <span class="sep" />}
          {readingTime(post.body)}
        </span>
      </div>

      {
        image && (
          <figure class="article-figure">
            <div class="frame">
              <ImageMod src={image} alt={title} width={1600} height={800} fit="cover" format="webp" loading="eager" />
            </div>
          </figure>
        )
      }
    </div>
  </div>

  <div class="section section--tight">
    <div class="wrap">
      <div class="article-shell" style={toc.length ? undefined : "grid-template-columns:minmax(0,1fr)"}>
        {
          toc.length > 0 && (
            <nav class="toc" aria-label="Daftar isi">
              <h4>Di halaman ini</h4>
              <ol>
                {toc.map((heading) => (
                  <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                ))}
              </ol>
            </nav>
          )
        }

        <div class="prose" style={toc.length ? undefined : "margin-inline:auto"}>
          <Content />

          <div class="post-tags">
            <h4 class="widget-title">Tag</h4>
            <div class="tag-cloud">
              {tags.map((tag: string) => <a href={`/tags/${slugify(tag)}`}>#{slugify(tag)}</a>)}
            </div>
          </div>

          <div class="post-tags" style="margin-top:1rem;border-top:0;padding-top:0;">
            <h4 class="widget-title">Bagikan</h4>
            <div class="tag-cloud">
              {
                shareLinks.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer nofollow">{link.name}</a>
                ))
              }
            </div>
          </div>

          {
            authorEntry && (
              <div class="author-box">
                {authorEntry.data.image && <img src={avatarUrl(authorEntry.data.image)} alt="" />}
                <div>
                  <h4>{authorEntry.data.title}</h4>
                  {authorEntry.data.description && <p class="role">// {authorEntry.data.description}</p>}
                  <p set:html={markdownify(authorEntry.body ?? "")} />
                </div>
              </div>
            )
          }

          <Disqus className="mt-5" client:only="react" />
        </div>
      </div>
    </div>
  </div>

  {
    similarPosts.length > 0 && (
      <section class="section related band" aria-labelledby="related-title">
        <div class="wrap">
          <div class="sec-head">
            <p class="kicker">// baca juga</p>
            <h2 id="related-title">Tulisan terkait</h2>
          </div>
          <div class="post-grid">
            {similarPosts.map((item) => <BlogCard data={item} />)}
          </div>
        </div>
      </section>
    )
  }
</article>

<!-- bungkus blok kode Markdown dengan bar nama bahasa + tombol Copy ala Byte.
     Berjalan sebelum main.js (defer) sehingga tombol Copy ikut aktif. -->
<script is:inline>
  document.querySelectorAll(".prose pre.astro-code").forEach(function (pre, i) {
    var id = "cb-" + (i + 1);
    var lang = pre.getAttribute("data-language") || "code";
    pre.id = id;
    var box = document.createElement("div");
    box.className = "codeblock";
    box.innerHTML =
      '<div class="cb-bar"><span class="cb-name"><span class="dot" style="background:var(--brand)"></span>' +
      lang +
      '</span><button class="copy-btn" type="button" data-copy="#' + id + '" aria-label="Salin kode">' +
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>' +
      '<span class="copy-label">Copy</span></button></div>';
    pre.parentNode.insertBefore(box, pre);
    box.appendChild(pre);
  });
</script>
