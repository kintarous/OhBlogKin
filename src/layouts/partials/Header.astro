---
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import settings from "@/config/settings.json";

export interface NavigationLink {
  name: string;
  url: string;
}

const { main }: { main: NavigationLink[] } = menu;
const { navigation_button } = config;
const { pathname } = Astro.url;

// menu aktif: cocok persis, atau halaman di bawahnya (mis. /blog/judul)
const isActive = (url: string) =>
  url === "/"
    ? pathname === "/"
    : pathname === url || pathname.startsWith(`${url}/`);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`Beranda ${settings.title}`}>
      <span>{settings.title}</span><span class="caret" aria-hidden="true"></span>
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Menu utama">
      {
        main.map((item) => (
          <a href={item.url} aria-current={isActive(item.url) ? "page" : undefined}>
            {item.name}
          </a>
        ))
      }
      {
        settings.admin_button && (
          <a class="d-sm-none" href={navigation_button.link}>
            {navigation_button.label}
          </a>
        )
      }
    </nav>

    <div class="header-actions">
      {
        settings.theme_switcher && (
          <button class="icon-btn theme-toggle" type="button" aria-pressed="false" aria-label="Ganti ke tema gelap">
            <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.2" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8" /></svg>
          </button>
        )
      }
      {
        settings.admin_button && (
          <a class="btn btn--ghost d-none d-sm-inline-flex" href={navigation_button.link}>
            {navigation_button.label}
          </a>
        )
      }
      <button class="icon-btn nav-toggle" type="button" aria-controls="main-nav" aria-expanded="false" aria-label="Buka menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      </button>
    </div>
  </div>
</header>
