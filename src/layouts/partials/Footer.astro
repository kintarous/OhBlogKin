---
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import DynamicIcon from "@/helpers/DynamicIcon";
import { getAllTaxonomy, getTaxonomy } from "@/lib/taxonomyParser.astro";
import { humanize, markdownify } from "@/lib/utils/textConverter";

const { main, footer }: { main: { name: string; url: string }[]; footer: { name: string; url: string }[] } = menu;

// lima kategori dengan tulisan terbanyak
const allCategories = await getAllTaxonomy("blog", "categories");
const topCategories = (await getTaxonomy("blog", "categories"))
  .map((name) => ({ name, count: allCategories.filter((c) => c === name).length }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 5);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-about">
        <a class="brand" href="/" aria-label={`Beranda ${config.site.title}`}>
          <span>{config.site.logo_text}</span><span class="caret" aria-hidden="true"></span>
        </a>
        <p>{config.metadata.meta_description}</p>
        <div class="footer-social">
          {
            social.main.map((item) => (
              <a href={item.link} aria-label={item.name} target="_blank" rel="noopener noreferrer nofollow">
                <DynamicIcon icon={item.icon} aria-hidden="true" />
              </a>
            ))
          }
        </div>
      </div>

      <div class="fcol">
        <h4>Menu</h4>
        <ul>
          {main.map((item) => <li><a href={item.url}>{item.name}</a></li>)}
        </ul>
      </div>

      <div class="fcol">
        <h4>Kategori</h4>
        <ul>
          {
            topCategories.map((category) => (
              <li><a href={`/categories/${category.name}`}>{humanize(category.name)}</a></li>
            ))
          }
        </ul>
      </div>

      <div class="fcol">
        <h4>Lainnya</h4>
        <ul>
          {footer.map((item) => <li><a href={item.url}>{item.name}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p set:html={markdownify(config.params.copyright)} />
      <p class="built">Free template by <a href="https://uicookies.com/" rel="noopener">uiCookies</a></p>
    </div>
  </div>
</footer>
